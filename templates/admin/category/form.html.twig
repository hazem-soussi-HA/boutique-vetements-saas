{% extends 'admin/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block admin_body %}
    <div class="admin-head">
        <div>
            <span class="crumb-label">Catalogue</span>
            <h1>{{ title }}</h1>
        </div>
        <a class="btn btn--sm btn--ghost" href="{{ path('admin_category_index') }}">← Retour aux catégories</a>
    </div>

    <div class="admin-form-wrap">
        <div class="form-card">
            {{ form_start(form) }}
                {{ form_row(form.name) }}
                {{ form_row(form.slug) }}
                {{ form_row(form.description) }}
                <div class="form-row">
                    {{ form_row(form.icon) }}
                    {{ form_row(form.position) }}
                </div>
                {{ form_row(form.isActive) }}

                <div class="form-actions">
                    <button class="btn" type="submit">{{ category.id ? 'Enregistrer' : 'Créer la catégorie' }}</button>
                    <a class="btn btn--ghost" href="{{ path('admin_category_index') }}">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}