{% extends 'admin/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block admin_body %}
    <div class="admin-head">
        <div>
            <span class="crumb-label">Catalogue</span>
            <h1>{{ title }}</h1>
        </div>
        <a class="btn btn--sm btn--ghost" href="{{ path('admin_product_index') }}">← Retour aux produits</a>
    </div>

    <div class="admin-form-wrap">
        <div class="form-card">
            {{ form_start(form) }}

            <h3 style="font-family:var(--font-body); font-size:.78rem; letter-spacing:.16em; text-transform:uppercase; margin:0 0 20px;">Informations</h3>
            <div class="form-row">
                {{ form_row(form.name) }}
                {{ form_row(form.sku) }}
            </div>
            {{ form_row(form.slug) }}
            {{ form_row(form.shortDescription) }}
            {{ form_row(form.description) }}

            <h3 style="font-family:var(--font-body); font-size:.78rem; letter-spacing:.16em; text-transform:uppercase; margin:32px 0 20px;">Tarification &amp; stock</h3>
            <div class="form-row">
                {{ form_row(form.price) }}
                {{ form_row(form.salePrice) }}
            </div>
            <div class="form-row">
                {{ form_row(form.stock) }}
                {{ form_row(form.category) }}
            </div>

            <h3 style="font-family:var(--font-body); font-size:.78rem; letter-spacing:.16em; text-transform:uppercase; margin:32px 0 20px;">Visuel &amp; attributs</h3>
            {{ form_row(form.mainImage) }}
            <div class="form-row">
                {{ form_row(form.sizes) }}
                {{ form_row(form.colors) }}
            </div>
            {{ form_row(form.materials) }}
            {{ form_row(form.gender) }}

            <h3 style="font-family:var(--font-body); font-size:.78rem; letter-spacing:.16em; text-transform:uppercase; margin:32px 0 20px;">Visibilité</h3>
            <div style="display:grid; gap:12px;">
                {{ form_row(form.isActive) }}
                {{ form_row(form.isFeatured) }}
                {{ form_row(form.isNew) }}
            </div>

            <div class="form-actions">
                <button class="btn" type="submit">{{ product.id ? 'Enregistrer les modifications' : 'Créer le produit' }}</button>
                <a class="btn btn--ghost" href="{{ path('admin_product_index') }}">Annuler</a>
            </div>

            {{ form_end(form) }}
        </div>

        {% if product.mainImage %}
            <div class="panel" style="margin-top:22px;">
                <div class="panel-head"><h2>Aperçu de l’image principale</h2></div>
                <div class="panel-body">
                    <div style="width:220px; aspect-ratio:3/4; border-radius:10px; overflow:hidden; background:var(--cream-2); border:1px solid var(--line);">
                        <img src="{{ product.mainImage }}" alt="" style="width:100%;height:100%;object-fit:cover;">
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}