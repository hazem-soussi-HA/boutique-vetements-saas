<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Back-office{% endblock %} — {{ settings.shopName }}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/site.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<div class="admin-shell">
    {% block sidebar %}
        <aside class="admin-side">
            <div class="brand-mark">
                <strong>{{ settings.shopName }}</strong>
                <span>Back-office</span>
            </div>

            {% set route = app.request.attributes.get('_route') %}
            <nav class="admin-nav" aria-label="Navigation back-office">
                <div class="admin-nav-label">Pilotage</div>
                <a href="{{ path('admin_dashboard') }}" class="{{ route starts with 'admin_dashboard' ? 'is-active' : '' }}">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="8"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="11" width="7" height="10"/><rect x="3" y="14" width="7" height="7"/></svg>
                    Tableau de bord
                </a>

                <div class="admin-nav-label">Catalogue</div>
                <a href="{{ path('admin_product_index') }}" class="{{ route starts with 'admin_product' ? 'is-active' : '' }}">
                    <svg viewBox="0 0 24 24"><path d="M7 8h10l-1 12H8L7 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                    Produits
                </a>
                <a href="{{ path('admin_category_index') }}" class="{{ route starts with 'admin_category' ? 'is-active' : '' }}">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="8" height="7"/><rect x="13" y="4" width="8" height="7"/><rect x="3" y="14" width="8" height="7"/><rect x="13" y="14" width="8" height="7"/></svg>
                    Catégories
                </a>
                <a href="{{ path('admin_brand_index') }}" class="{{ route starts with 'admin_brand' ? 'is-active' : '' }}">
                    <svg viewBox="0 0 24 24"><path d="M4 20V7l8-4 8 4v13"/><path d="M9 20v-6h6v6"/></svg>
                    Marques
                </a>

                <div class="admin-nav-label">Activité</div>
                <a href="{{ path('admin_order_index') }}" class="{{ route starts with 'admin_order' ? 'is-active' : '' }}">
                    <svg viewBox="0 0 24 24"><path d="M5 4h14l-1 16H6L5 4z"/><path d="M9 9h6"/></svg>
                    Commandes
                </a>
                <a href="{{ path('admin_message_index') }}" class="{{ route starts with 'admin_message' ? 'is-active' : '' }}">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/></svg>
                    Messages
                    {% if unread_count|default(0) > 0 %}<span class="badge">{{ unread_count }}</span>{% endif %}
                </a>
                <a href="{{ path('admin_subscriber_index') }}" class="{{ route starts with 'admin_subscriber' ? 'is-active' : '' }}">
                    <svg viewBox="0 0 24 24"><path d="M4 7h16v12H4z"/><path d="M4 7l8 7 8-7"/></svg>
                    Newsletter
                </a>

                <div class="admin-nav-label">Configuration</div>
                <a href="{{ path('admin_settings') }}" class="{{ route starts with 'admin_settings' ? 'is-active' : '' }}">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 3v2m0 14v2M3 12h2m14 0h2M6 6l1.5 1.5M16.5 16.5L18 18M18 6l-1.5 1.5M7.5 16.5L6 18"/></svg>
                    Paramètres
                </a>
            </nav>

            <div class="admin-side-foot">
                <a href="{{ path('app_home') }}" target="_blank" rel="noopener">Voir le site ↗</a>
                <a href="{{ path('app_logout') }}">Se déconnecter</a>
            </div>
        </aside>
    {% endblock %}

    <main class="admin-main">
        {% block flashes %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert--{{ type }}" data-autohide>{{ message }}</div>
                {% endfor %}
            {% endfor %}
        {% endblock %}

        {% block admin_body %}{% endblock %}
    </main>
</div>
<script src="/js/site.js" defer></script>
{% block javascripts %}{% endblock %}
</body>
</html>