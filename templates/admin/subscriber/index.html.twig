{% extends 'admin/base.html.twig' %}

{% block title %}Newsletter{% endblock %}

{% block admin_body %}
    <div class="admin-head">
        <div>
            <span class="crumb-label">Activité</span>
            <h1>Abonnés newsletter</h1>
            <p class="text-muted" style="margin:6px 0 0;">{{ subscribers|length }} au total · {{ activeCount }} actif{{ activeCount > 1 ? 's' : '' }}</p>
        </div>
    </div>

    <div class="panel">
        <div class="panel-body panel-body--flush">
            <table class="data-table">
                <thead><tr><th>E-mail</th><th>Statut</th><th>Inscription</th><th style="text-align:right;">Actions</th></tr></thead>
                <tbody>
                    {% for subscriber in subscribers %}
                        <tr>
                            <td>
                                <a href="mailto:{{ subscriber.email }}"><strong>{{ subscriber.email }}</strong></a>
                            </td>
                            <td>
                                {% if subscriber.isActive %}<span class="tag tag--ok">Actif</span>{% else %}<span class="tag tag--muted">Désabonné</span>{% endif %}
                            </td>
                            <td class="text-muted">{{ subscriber.subscribedAt|date('d/m/Y') }}</td>
                            <td>
                                <div style="display:flex; gap:6px; justify-content:flex-end;">
                                    <form method="post" action="{{ path('admin_subscriber_toggle', {id: subscriber.id}) }}" class="inline-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ subscriber.id) }}">
                                        <button class="icon-action" type="submit" title="{{ subscriber.isActive ? 'Désabonner' : 'Réactiver' }}">
                                            {% if subscriber.isActive %}
                                                <svg viewBox="0 0 24 24"><path d="M3 3l18 18"/><path d="M10.6 5.1A9 9 0 0 1 12 5c5 0 9 4.5 9 7 0 .9-.5 2-1.4 3"/><path d="M6.2 6.7C4.4 8 3 10 3 12c0 2.5 4 7 9 7 1.6 0 3.1-.5 4.3-1.3"/></svg>
                                            {% else %}
                                                <svg viewBox="0 0 24 24"><path d="M3 12c0-2.5 4-7 9-7s9 4.5 9 7-4 7-9 7-9-4.5-9-7z"/><circle cx="12" cy="12" r="3"/></svg>
                                            {% endif %}
                                        </button>
                                    </form>
                                    <form method="post" action="{{ path('admin_subscriber_delete', {id: subscriber.id}) }}" class="inline-form"
                                          data-confirm="Supprimer cet abonné ?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ subscriber.id) }}">
                                        <button class="icon-action icon-action--danger" type="submit" title="Supprimer">
                                            <svg viewBox="0 0 24 24"><path d="M5 7h14"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-muted" style="text-align:center; padding:48px;">Aucun abonné pour le moment.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}