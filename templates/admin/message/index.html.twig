{% extends 'admin/base.html.twig' %}

{% block title %}Messages{% endblock %}

{% block admin_body %}
    <div class="admin-head">
        <div>
            <span class="crumb-label">Activité</span>
            <h1>Boîte de réception</h1>
        </div>
    </div>

    <div class="panel">
        <div class="panel-body panel-body--flush">
            {% if messages is not empty %}
                {% for message in messages %}
                    <div style="padding:24px; border-bottom:1px solid var(--line); {{ not message.isRead ? 'background:#fffdf7;' : '' }}">
                        <div style="display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; align-items:flex-start;">
                            <div style="flex:1; min-width:260px;">
                                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:8px;">
                                    <strong style="font-size:1.02rem;">{{ message.subject }}</strong>
                                    {% if not message.isRead %}<span class="tag tag--warn">Nouveau</span>{% endif %}
                                </div>
                                <p class="text-muted" style="font-size:.84rem; margin:0 0 12px;">
                                    {{ message.fullName }} · <a href="mailto:{{ message.email }}">{{ message.email }}</a>
                                    {% if message.phone %} · {{ message.phone }}{% endif %}
                                    · {{ message.createdAt|date('d/m/Y H:i') }}
                                </p>
                                <p style="margin:0; max-width:80ch;">{{ message.message }}</p>
                            </div>

                            <div style="display:flex; gap:6px;">
                                <a class="btn btn--sm btn--ghost" href="mailto:{{ message.email }}?subject=Re: {{ message.subject|url_encode }}">Répondre</a>
                                <form method="post" action="{{ path('admin_message_toggle', {id: message.id}) }}" class="inline-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ message.id) }}">
                                    <button class="icon-action" type="submit" title="{{ message.isRead ? 'Marquer comme non lu' : 'Marquer comme lu' }}">
                                        {% if message.isRead %}
                                            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/></svg>
                                        {% else %}
                                            <svg viewBox="0 0 24 24"><path d="M4 7l8 6 8-6"/><path d="M4 7h16"/></svg>
                                        {% endif %}
                                    </button>
                                </form>
                                <form method="post" action="{{ path('admin_message_delete', {id: message.id}) }}" class="inline-form"
                                      data-confirm="Supprimer ce message ?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.id) }}">
                                    <button class="icon-action icon-action--danger" type="submit" title="Supprimer">
                                        <svg viewBox="0 0 24 24"><path d="M5 7h14"/><path d="M9 7V5h6v2"/><path d="M6 7l1 13h10l1-13"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="empty-state">
                    <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/></svg>
                    <h3>Aucun message</h3>
                    <p class="text-muted">Les messages du formulaire de contact arriveront ici.</p>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}