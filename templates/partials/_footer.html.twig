<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <div class="brand-mark">
                    <strong>{{ settings ? settings.shopName : 'Maison Soussi' }}</strong>
                    <span>{{ settings and settings.tagline ? settings.tagline : 'Mode & Tradition' }}</span>
                </div>
                <p style="margin-top:18px; max-width:36ch;">
                    Une maison de mode algérienne : des pièces choisies, des matières soignées,
                    et un service client qui répond vraiment.
                </p>
                <div class="social-row">
                    {% if settings and settings.facebookUrl %}<a href="{{ settings.facebookUrl }}" rel="noopener" target="_blank" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h2V5h-2a4 4 0 0 0-4 4v2H8v3h2v6h3v-6h2l1-3h-3V9a1 1 0 0 1 1-1z"/></svg></a>{% endif %}
                    {% if settings and settings.instagramUrl %}<a href="{{ settings.instagramUrl }}" rel="noopener" target="_blank" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17" cy="7" r=".9" fill="currentColor" stroke="none"/></svg></a>{% endif %}
                    {% if settings and settings.tiktokUrl %}<a href="{{ settings.tiktokUrl }}" rel="noopener" target="_blank" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10a3.5 3.5 0 1 1-3-3.5"/><path d="M14 4c.6 2 2 3.4 4 3.6"/></svg></a>{% endif %}
                    {% if settings and settings.whatsappUrl %}<a href="{{ settings.whatsappUrl }}" rel="noopener" target="_blank" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 0 1-11.8 7L4 20l1.1-4A8 8 0 1 1 20 12z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5"/></svg></a>{% endif %}
                </div>
            </div>

            <div>
                <h4>Boutique</h4>
                <ul>
                    <li><a href="{{ path('app_shop') }}">Tous les articles</a></li>
                    <li><a href="{{ path('app_shop') }}?promo=1">Promotions</a></li>
                    <li><a href="{{ path('app_shop') }}?stock=1">En stock</a></li>
                    {% for category in nav_categories()|slice(0, 4) %}
                        <li><a href="{{ path('app_shop_category', {slug: category.slug}) }}">{{ category.name }}</a></li>
                    {% endfor %}
                </ul>
            </div>

            <div>
                <h4>La maison</h4>
                <ul>
                    <li><a href="{{ path('app_about') }}">Notre histoire</a></li>
                    <li><a href="{{ path('app_contact') }}">Nous contacter</a></li>
                    <li><a href="{{ path('app_contact') }}#faq">Livraison &amp; retours</a></li>
                    <li><a href="{{ path('app_legal') }}">Mentions légales</a></li>
                    <li><a href="{{ path('app_login') }}">Espace gérant</a></li>
                </ul>
            </div>

            <div>
                <h4>Newsletter</h4>
                <p>Nouveautés, ventes privées et -10% sur votre première commande.</p>
                <form method="post" action="{{ path('app_newsletter') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('newsletter') }}">
                    <div style="display:flex; gap:8px;">
                        <input class="form-input" type="email" name="email" placeholder="vous@exemple.com" required aria-label="Votre adresse e-mail">
                        <button class="btn btn--gold" type="submit">OK</button>
                    </div>
                </form>
                <p style="margin-top:18px; font-size:.84rem;">
                    {% if settings and settings.contactEmail %}{{ settings.contactEmail }}{% endif %}{% if settings and settings.contactPhone %}<br>{{ settings.contactPhone }}{% endif %}
                </p>
            </div>
        </div>

        <div class="footer-bottom">
            <span>© {{ 'now'|date('Y') }} {{ settings ? settings.shopName : 'Maison Soussi' }} — Tous droits réservés.</span>
            <span>Conçu &amp; développé par <strong style="color:var(--gold)">Hazem Soussi</strong></span>
        </div>
    </div>
</footer>