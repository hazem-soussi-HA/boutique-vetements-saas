<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ block('title_suffix') }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Maison de mode algérienne : robes, vestes et accessoires pour femme et homme.{% endblock %}">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/site.css">
    {% block stylesheets %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
{% block flashes %}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="container" style="padding-top:18px;">
                <div class="alert alert--{{ type }}" data-autohide>{{ message }}</div>
            </div>
        {% endfor %}
    {% endfor %}
{% endblock %}

{% block header %}{% include 'partials/_header.html.twig' %}{% endblock %}

<main>
    {% block body %}{% endblock %}
</main>

{% block footer %}{% include 'partials/_footer.html.twig' %}{% endblock %}

<script src="/js/site.js" defer></script>
{% block javascripts %}{% endblock %}
</body>
</html>