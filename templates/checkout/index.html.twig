{% extends 'base.html.twig' %}

{% block title %}Commande — {{ settings.shopName }}{% endblock %}

{% block body %}
    <div class="container">
        <nav class="crumbs" aria-label="Fil d'Ariane">
            <a href="{{ path('app_home') }}">Accueil</a> <span>/</span>
            <a href="{{ path('app_cart') }}">Panier</a> <span>/</span> <span class="text-muted">Commande</span>
        </nav>

        <h1 style="font-size: clamp(2rem,4vw,3rem); margin-bottom:34px;">Finaliser la commande</h1>

        <div class="cart-layout">
            <div>
                {{ form_start(form, {attr: {class: 'form-card'}}) }}

                <h3 style="font-family: var(--font-body); font-size:.82rem; letter-spacing:.16em; text-transform:uppercase; margin-bottom:20px;">
                    Coordonnées
                </h3>

                <div class="form-row">
                    {{ form_row(form.customerFirstName) }}
                    {{ form_row(form.customerLastName) }}
                </div>
                <div class="form-row">
                    {{ form_row(form.customerEmail) }}
                    {{ form_row(form.customerPhone) }}
                </div>

                <h3 style="font-family: var(--font-body); font-size:.82rem; letter-spacing:.16em; text-transform:uppercase; margin:34px 0 20px;">
                    Livraison
                </h3>
                <div class="form-row">
                    {{ form_row(form.shippingCity) }}
                    {{ form_row(form.shippingWilaya) }}
                </div>
                {{ form_row(form.shippingAddress) }}

                <h3 style="font-family: var(--font-body); font-size:.82rem; letter-spacing:.16em; text-transform:uppercase; margin:34px 0 20px;">
                    Paiement
                </h3>
                <div class="field">
                    {{ form_widget(form.paymentMethod) }}
                </div>

                {{ form_row(form.notes) }}

                <button class="btn btn--lg btn--block" type="submit">Confirmer ma commande · {{ total|money }}</button>
                <p style="text-align:center; font-size:.8rem; color:var(--ink-mute); margin-top:14px; margin-bottom:0;">
                    En confirmant, vous acceptez nos conditions de vente et de retour.
                </p>

                {{ form_end(form) }}
            </div>

            <aside class="summary">
                <h3>Votre commande</h3>

                {% for line in lines %}
                    <div style="display:flex; gap:12px; padding:12px 0; border-bottom: 1px solid var(--line);">
                        <div style="width:52px; height:66px; border-radius:4px; overflow:hidden; background:var(--cream-2); flex:none;">
                            {% if line.product.mainImage %}<img src="{{ line.product.mainImage }}" alt="" style="width:100%;height:100%;object-fit:cover;" loading="lazy">{% endif %}
                        </div>
                        <div style="flex:1; min-width:0;">
                            <p style="font-size:.85rem; margin:0 0 2px; font-weight:600;">{{ line.product.name }}</p>
                            <p style="font-size:.76rem; color:var(--ink-mute); margin:0;">
                                {% if line.size %}Taille {{ line.size }}{% endif %}{% if line.color %} · {{ line.color }}{% endif %} · ×{{ line.quantity }}
                            </p>
                        </div>
                        <span style="font-size:.85rem; font-weight:600; white-space:nowrap;">{{ line.total|money }}</span>
                    </div>
                {% endfor %}

                <div class="summary-row" style="margin-top:14px;"><span>Sous-total</span> <span>{{ subtotal|money }}</span></div>
                <div class="summary-row"><span>Livraison</span> <span>{{ shipping == 0 ? 'Offerte' : shipping|money }}</span></div>
                <div class="summary-row total"><span>Total</span> <span>{{ total|money }}</span></div>
            </aside>
        </div>
    </div>
{% endblock %}