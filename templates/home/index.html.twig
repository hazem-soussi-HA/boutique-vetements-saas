{% extends 'base.html.twig' %}
{% import 'partials/product.html.twig' as p %}

{% block title %}{{ settings.shopName }} — {{ settings.tagline }}{% endblock %}
{% block meta_description %}{{ settings.heroSubtitle ? settings.heroSubtitle|striptags|text_limit(155) : 'Boutique de vêtements en ligne : robes, vestes et accessoires pour femme et homme.' }}{% endblock %}

{% block body %}
    <section class="hero">
        <div class="hero-bg">
            {% if settings.heroImage %}
                <img src="{{ settings.heroImage }}" alt="">
            {% else %}
                <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                    <defs>
                        <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#3b3029"/><stop offset="55%" stop-color="#7d6a58"/><stop offset="100%" stop-color="#c9b39a"/>
                        </linearGradient>
                    </defs>
                    <rect width="1600" height="900" fill="url(#g1)"/>
                    <circle cx="1180" cy="280" r="200" fill="#e7dbcd" opacity=".5"/>
                    <path d="M700 900V420c0-40 32-72 72-72h56c40 0 72 32 72 72v480z" fill="#f3ece4" opacity=".22"/>
                </svg>
            {% endif %}
        </div>

        <div class="container">
            <div class="hero-inner">
                <span class="eyebrow">Nouvelle collection · Automne</span>
                <h1>{{ settings.heroTitle ?? 'Des pièces qui racontent votre histoire' }}</h1>
                <p>{{ settings.heroSubtitle ?? 'Des matières choisies, des coupes pensées pour durer plus d’une saison.' }}</p>
                <div class="hero-cta">
                    <a class="btn btn--light btn--lg" href="{{ path('app_shop') }}">Découvrir la boutique</a>
                    <a class="btn btn--ghost btn--lg" style="--btn-fg:#faf6f1;border-color:#faf6f1" href="#nouveautes">Nouveautés</a>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="hero-stats">
                <div><strong>{{ featured|length }}+</strong><span>Pièces</span></div>
                <div><strong>{{ categories|length }}</strong><span>Collections</span></div>
                <div><strong>{{ brands|length }}</strong><span>Maisons</span></div>
                <div><strong>48h</strong><span>Expédition</span></div>
            </div>
        </div>
    </section>

    <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
            {% for i in 1..2 %}
                <span>Livraison offerte dès {{ settings.freeShippingThreshold|money }}</span><span>•</span>
                <span>Paiement à la livraison</span><span>•</span>
                <span>Retours gratuits sous 14 jours</span><span>•</span>
                <span>Couture locale</span><span>•</span>
                <span>Conseil en taille par WhatsApp</span><span>•</span>
            {% endfor %}
        </div>
    </div>

    <section class="feature-strip">
        <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
            <h4>Livraison 58 wilayas</h4>
            <p>
                {% if settings.freeShippingThreshold > 0 %}
                    Offerte dès {{ settings.freeShippingThreshold|money }}, sinon {{ settings.shippingFee|money }}.
                {% else %}
                    Frais de livraison : {{ settings.shippingFee|money }}.
                {% endif %}
            </p>
        </div>
        <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M12 3l7 4v5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V7z"/><path d="M9 12l2 2 4-4"/></svg>
            <h4>Qualité garantie</h4>
            <p>Contrôle pièce par pièce avant expédition.</p>
        </div>
        <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 1 3 6.2"/><path d="M4 19v-5h5"/></svg>
            <h4>Retours 14 jours</h4>
            <p>Échange de taille gratuit, sans justification.</p>
        </div>
        <div class="feature">
            <svg viewBox="0 0 24 24"><path d="M4 5h16v12H7l-3 3z"/><path d="M8 9h8M8 13h5"/></svg>
            <h4>Conseil personnalisé</h4>
            <p>Une équipe à Alger, du lundi au samedi.</p>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-head reveal">
                <div>
                    <span class="eyebrow">Nos univers</span>
                    <h2>Parcourir par collection</h2>
                </div>
                <a class="link-arrow" href="{{ path('app_shop') }}">Tout voir →</a>
            </div>

            <div class="cat-grid">
                {% for category in categories|slice(0, 5) %}
                    <a class="cat-card reveal" href="{{ path('app_shop_category', {slug: category.slug}) }}">
                        {% if category.image %}
                            <img src="{{ category.image }}" alt="{{ category.name }}" loading="lazy">
                        {% else %}
                            <svg viewBox="0 0 300 400" aria-hidden="true">
                                <rect width="300" height="400" fill="hsl({{ 20 + loop.index0 * 14 }}, {{ 26 + loop.index0 * 5 }}%, {{ 82 - loop.index0 * 3 }}%)"/>
                                <text x="150" y="215" text-anchor="middle" font-size="72">{{ category.icon ?? '✦' }}</text>
                            </svg>
                        {% endif %}
                        <div class="cat-card-body">
                            <h3>{{ category.name }}</h3>
                            <span>{{ category.products|length }} pièces</span>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="section" id="nouveautes" style="background: var(--white); border-block: 1px solid var(--line);">
        <div class="container">
            <div class="section-head reveal">
                <div>
                    <span class="eyebrow">Fraîchement arrivés</span>
                    <h2>Nouveautés de la saison</h2>
                    <p>Les dernières pièces ajoutées à la boutique, disponibles en quantités limitées.</p>
                </div>
                <a class="link-arrow" href="{{ path('app_shop') }}">Voir la boutique →</a>
            </div>

            {% if newArrivals is not empty %}
                {{ p.grid(newArrivals) }}
            {% else %}
                <p class="text-muted">Aucune nouveauté pour le moment.</p>
            {% endif %}
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="split">
                <div class="split-media reveal">
                    <svg viewBox="0 0 600 750" aria-hidden="true">
                        <defs>
                            <linearGradient id="s1" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0%" stop-color="#8c6d38"/><stop offset="100%" stop-color="#e7dbcd"/>
                            </linearGradient>
                        </defs>
                        <rect width="600" height="750" fill="url(#s1)"/>
                        <path d="M230 180l70 46 70-46 150 76-52 104-42-22v412H224V338l-42 22-52-104z" fill="#faf6f1" opacity=".9"/>
                    </svg>
                </div>
                <div class="reveal">
                    <span class="eyebrow">Notre méthode</span>
                    <h2>Confectionné à Alger, pensé pour durer</h2>
                    <p class="lead">
                        Nous travaillons avec des ateliers de couture du centre-ville : patronage validé,
                        essayage sur mannequin, contrôle final avant chaque expédition.
                    </p>
                    <p class="text-muted">
                        Pas de collection jetable. Chaque pièce est produite en petite série, ce qui nous permet
                        d’ajuster les coupes season après saison et de garder des prix justes.
                    </p>
                    <div class="steps" style="margin-top:34px; grid-template-columns: 1fr 1fr;">
                        <div class="step"><h4>Matières tracées</h4><p>Laine, lin et soie achetés auprès de filateurs partenaires.</p></div>
                        <div class="step"><h4>Prix transparents</h4><p>Le prix affiché comprend le coût réel de confection.</p></div>
                    </div>
                    <p style="margin-top:34px;">
                        <a class="link-arrow" href="{{ path('app_about') }}">Notre histoire →</a>
                    </p>
                </div>
            </div>
        </div>
    </section>

    {% if onSale is not empty %}
        <section class="section" style="background: var(--cream-2); border-block: 1px solid var(--line);">
            <div class="container">
                <div class="section-head reveal">
                    <div>
                        <span class="eyebrow">Pièces en promo</span>
                        <h2>Promotions en cours</h2>
                        <p>Réductions limitées sur une sélection de pièces.</p>
                    </div>
                    <a class="link-arrow" href="{{ path('app_shop', {promo: 1}) }}">Toutes les promos →</a>
                </div>
                {{ p.grid(onSale) }}
            </div>
        </section>
    {% endif %}

    <section class="section">
        <div class="container">
            <div class="section-head reveal">
                <div>
                    <span class="eyebrow">Coup de cœur</span>
                    <h2>Les plus commandés</h2>
                </div>
                <a class="link-arrow" href="{{ path('app_shop') }}">Explorer →</a>
            </div>
            {{ p.grid(featured) }}
        </div>
    </section>

    <section class="section" style="padding-top:0;">
        <div class="container">
            <div class="section-head reveal" style="text-align:center; justify-content:center;">
                <div>
                    <span class="eyebrow">Ils nous font confiance</span>
                    <h2>Ce que disent nos clientes</h2>
                </div>
            </div>
            <div class="quote-grid">
                <div class="quote reveal">
                    <div class="stars">★★★★★</div>
                    <p>La robe Nour en lin est exactement comme sur les photos, et la taille était parfaite. Livraison à Sétif en 48h.</p>
                    <footer>Amina B. · Alger</footer>
                </div>
                <div class="quote reveal">
                    <div class="stars">★★★★★</div>
                    <p>J’ai commandé le smoking pour un mariage. Retouchesoffertes par l’équipe, résultat impeccable. Je recommande.</p>
                    <footer>Yacine H. · Oran</footer>
                </div>
                <div class="quote reveal">
                    <div class="stars">★★★★★</div>
                    <p>Première commande et déjà une deuxième. Le service WhatsApp répond en quelques minutes, c’est rare.</p>
                    <footer>Sofiane M. · Blida</footer>
                </div>
            </div>
        </div>
    </section>

    <section class="newsletter-band section">
        <div class="container">
            <div class="newsletter-inner reveal">
                <div>
                    <span class="eyebrow">Newsletter</span>
                    <h2 style="margin-bottom:12px;">-10% sur votre première commande</h2>
                    <p class="text-muted" style="max-width:46ch; margin:0;">
                        Inscription mensuelle, pas de spam. Vous pouvez vous désinscrire en un clic.
                    </p>
                </div>
                <div>
                    <form method="post" action="{{ path('app_newsletter') }}" style="display:flex; gap:10px; flex-wrap:wrap;">
                        <input type="hidden" name="_token" value="{{ csrf_token('newsletter') }}">
                        <input class="form-input" style="flex:1; min-width:220px;" type="email" name="email" placeholder="votre@email.com" required aria-label="Votre adresse e-mail">
                        <button class="btn btn--gold" type="submit">Je m’inscris</button>
                    </form>
                    <p class="text-muted" style="font-size:.8rem; margin-top:14px;">En vous inscrivant, vous acceptez notre politique de confidentialité.</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}